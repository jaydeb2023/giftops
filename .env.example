# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (Settings → API Keys in your Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Settings → Webhooks → create one pointed at /api/webhooks/razorpay,
# subscribe to the "payment_link.paid" event, and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---------------- GiftOps (multi-company) ----------------
NEXT_PUBLIC_APP_URL=https://giftops.evynta.in
# Platform owners (you). Comma separated login emails that can open /app/platform and see ALL companies.
RV_SUPER_ADMIN_EMAILS=you@example.com
# Set to false to stop new companies signing themselves up (you then add them from the Platform page)
RV_SIGNUP_OPEN=true
# Company (slug) that receives enquiries from the GiftOps website contact form
RV_SITE_ORG_SLUG=evynta
# Shared secrets used by ALL companies (one Meta app, one scheduler)
RV_WA_VERIFY_TOKEN=choose-any-string
RV_WA_APP_SECRET=
RV_AI_CALL_SECRET=choose-any-string
RV_META_VERIFY_TOKEN=choose-any-string
RV_META_APP_SECRET=
CRON_SECRET=choose-a-long-random-string
# NOTE: each company's own WhatsApp number, tokens, AI-call provider, Facebook/Instagram page and
# lead-form key are entered by that company in Settings > Integrations (stored per company, not here).
