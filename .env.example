# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay (Settings → API Keys in your Razorpay Dashboard)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Settings → Webhooks → create one pointed at /api/webhooks/razorpay,
# subscribe to the "payment_link.paid" event, and paste its secret here.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ---------------- Raahvia CRM / OMS ----------------
NEXT_PUBLIC_APP_URL=https://your-domain.com
# Comma separated emails allowed to become the first admin (optional; first signup wins if empty)
RV_ADMIN_EMAILS=you@example.com
# WhatsApp Cloud API (Meta)
RV_WA_PHONE_NUMBER_ID=
RV_WA_TOKEN=
RV_WA_VERIFY_TOKEN=choose-any-string
RV_WA_APP_SECRET=
# AI calling provider (any provider with an HTTP "start call" API)
RV_AI_CALL_API_URL=
RV_AI_CALL_API_KEY=
RV_AI_CALL_SECRET=choose-any-string
RV_AI_CALL_SCRIPT=
# Protects /api/rv/address-chase/run for schedulers
CRON_SECRET=choose-a-long-random-string

# ---------------- Lead sources ----------------
# Website form / chatbot / Zapier etc. send header  x-api-key: <this value>  to /api/rv/public/lead
RV_LEAD_API_KEY=choose-a-long-random-string
# Facebook + Instagram (one Meta app): webhook URL /api/rv/webhooks/meta
RV_META_VERIFY_TOKEN=choose-any-string
RV_META_APP_SECRET=
RV_META_PAGE_TOKEN=
